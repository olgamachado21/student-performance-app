# Copiar este ficheiro para ".env" e ajustar os valores conforme necessário.

# "sqlite" -> base de dados local em ficheiro, sem servidor (omissão, para testar já)
# "mssql"  -> SQL Server, gerido através do SSMS (ver sql/schema.sql)
DB_DRIVER=sqlite

# Caminho do ficheiro SQLite (só relevante se DB_DRIVER=sqlite). Por omissão fica
# em data/student_performance.db. Só precisas de mudar isto se estiveres a correr
# o projeto a partir de uma pasta em rede/sincronizada onde o SQLite dê erros de
# escrita — nesse caso aponta para uma pasta local, ex: C:\temp\student_performance.db
# SQLITE_DB_PATH=

# --- Só necessário se DB_DRIVER=mssql ---
MSSQL_SERVER=localhost\SQLEXPRESS
MSSQL_DATABASE=StudentPerformanceDB
MSSQL_ODBC_DRIVER=ODBC Driver 17 for SQL Server
# Autenticação Windows (a mesma usada no SSMS). Se preferires autenticação SQL,
# define MSSQL_TRUSTED_CONNECTION=no e preenche utilizador/palavra-passe.
MSSQL_TRUSTED_CONNECTION=yes
MSSQL_USER=
MSSQL_PASSWORD=
